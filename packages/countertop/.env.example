# Countertop needs one LLM key for its assistant. Your MCP server needs whatever it needs.
# Both of these are free; set either or both. Groq is tried first (fast), Gemini is the fallback.

# Groq — https://console.groq.com/keys (free, no card)
GROQ_API_KEY=
# GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# Any OpenAI-compatible endpoint. Defaults to Google Gemini — https://aistudio.google.com/apikey
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash
# LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-2.5-flash


{
  "name": "countertop",
  "version": "0.1.0",
  "description": "Countertop: an open-source, browser-based voice assistant simulator for testing MCP servers (Streamable HTTP client, MCP Apps host, elicitation, subscriptions, protocol inspector).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "vite build && node server.mjs --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aditya13504/countertop.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa",
    "voice",
    "simulator",
    "mcp-apps",
    "elicitation"
  ],
  "engines": {
    "node": ">=20"
  }
}
